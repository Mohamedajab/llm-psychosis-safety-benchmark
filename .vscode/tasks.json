{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Research: Streamlit viewer",
      "type": "process",
      "command": "python",
      "args": ["-m", "streamlit", "run", "streamlit_app.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Research: offline tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
